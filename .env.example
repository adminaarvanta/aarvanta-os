# Copy to .env.local for local development or set in Vercel → Settings → Environment Variables.

# --- Core ---
# demo = in-memory data, no login. production = Firestore + session auth.
APP_MODE=production

# Public URL (required for Twilio webhook signatures and outbound links)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Auth (required in production) ---
AUTH_SECRET=generate-a-long-random-secret
AUTH_EMAIL=agent@yourcompany.com
AUTH_PASSWORD=your-secure-password
AUTH_USER_ID=user_prod
# Optional comma-separated extras. admin@aarvanta.co and AUTH_EMAIL are always super-admins.
# SUPER_ADMIN_EMAILS=ops@aarvanta.co

# Google OAuth for free-tier signup / sign-in (optional but recommended)
# Create OAuth client in Google Cloud Console; redirect URI:
#   https://your-domain.com/api/auth/sso/callback
#   http://localhost:3000/api/auth/sso/callback
SSO_GOOGLE_ISSUER=https://accounts.google.com
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
# SSO_GOOGLE_SCOPES=openid email profile

# --- Tenant scope (required in production for bootstrap owner) ---
TENANT_ID=tenant_prod
WORKSPACE_ID=ws_prod
COMPANY_ID=company_prod
ORGANIZATION_NAME=Aarvanta OS
WORKSPACE_NAME=Main workspace

# --- Firebase / Firestore (required in production) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Force datastore backend: memory | firestore (optional; auto-detected)
# DATASTORE=firestore

# --- Cron (recommended in production) ---
# Protects /api/cron/sync-email. Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- OpenAI (optional — AI summaries, CRM scoring, workforce) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
AI_AUTO_SUMMARIZE=true
# AI_ALLOW_HEURISTIC_FALLBACK=false
# AI_CRM_QUALIFICATION_THRESHOLD=50

# --- WhatsApp Cloud API (WhatsApp OS) ---
# Outbound: ACCESS_TOKEN + PHONE_NUMBER_ID
# Inbound (production): VERIFY_TOKEN + APP_SECRET + webhook → /api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Twilio SMS & Voice (Voice OS) ---
# Requires NEXT_PUBLIC_APP_URL for TwiML + signature validation
# Messaging + Voice status webhook → /api/webhooks/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Voice TTS / cost controls
# Default TTS = ElevenLabs Sarah (warmer reception voice; billed inside Relay fee).
# VOICE_RELAY_TTS_PROVIDER=ElevenLabs
# VOICE_RELAY_TTS_VOICE=EXAVITQu4vr4xnSDxMaL
# Faster / flatter option: Mark flash_v2_5
# VOICE_RELAY_TTS_VOICE=UgBBYS2sOqTuMpoF3BR0-flash_v2_5-0.95_0.65_0.8
# Basic robotic fallback:
# VOICE_RELAY_TTS_PROVIDER=Amazon
# VOICE_RELAY_TTS_VOICE=Joanna-Neural
# True free-of-Relay mode: one-shot Polly <Say> only (no two-way AI, skips $0.07/min).
# Keep OFF for natural AI conversations.
# VOICE_RELAY_BUDGET_MODE=true

# Two-way AI voice (ConversationRelay on EC2 — see docs/VOICE_RELAY.md)
# Exact wss URL must match nginx + voice-relay .env
# VOICE_RELAY_WSS_URL=wss://onboarding.aarvanta.co/voice-relay/ws
# Shared secret for transcript POSTs + Knowledge Hub context from EC2
# → /api/webhooks/voice-relay and /api/voice/context
# VOICE_RELAY_CALLBACK_SECRET=
# If unset, WSS derived from ONBOARDING_SIDECAR_URL host + /voice-relay/ws

# --- Voice relay / HR notes ---
# HR onboarding runs natively in HR OS (no Python sidecar required).
# Optional: derive voice-relay WSS host from this URL if VOICE_RELAY_WSS_URL is unset:
# ONBOARDING_SIDECAR_URL=
# ONBOARDING_SIDECAR_SECRET=

# --- Gmail IMAP/SMTP (optional) ---
GMAIL_USER=support@yourdomain.com
GMAIL_APP_PASSWORD=
EMAIL_FROM=support@yourdomain.com
# EMAIL_REPLY_TO=
# EMAIL_MESSAGE_ID_DOMAIN=

# --- Channels ---
# CHANNELS_SIMULATE=true

# --- Cookies ---
# COOKIE_SECURE=true

# --- Demo / presentation ---
# ENABLE_LIVE_DEMO=true

# --- SSO (optional) ---
# SSO_AUTO_PROVISION=true

# --- Stripe (Billing + Build OS domain/hosting checkout) ---
# Use test keys first (sk_test_… / pk_test_…). Webhook endpoint: /api/webhooks/stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: map Dashboard Price IDs (otherwise Checkout uses price_data)
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_SCALE=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# STRIPE_PRICE_HOSTING_STARTER=price_...
# STRIPE_PRICE_HOSTING_STANDARD=price_...
# STRIPE_PRICE_HOSTING_GROWTH=price_...

# --- Partner & Affiliate admin allowlist (production) ---
# Comma-separated emails that can manage /affiliate/admin
# (workspace owners/admins always have access; this allowlist is for extra ops emails)
# AFFILIATE_ADMIN_EMAILS=ops@aarvanta.com,finance@aarvanta.com

# --- Domain reseller (name.com primary; OpenSRS fallback) ---
# name.com partner signup + API: docs/NAMECOM_SETUP.md
# Leave unset in demo mode — heuristic catalog is used offline.
# NAMECOM_USERNAME=
# NAMECOM_API_TOKEN_DEV=
# NAMECOM_API_TOKEN=
# NAMECOM_ENV=test
# NAMECOM_FORCE_LIVE=true

# Shared retail pricing (USD wholesale → shopper currency)
# DOMAIN_RETAIL_MARKUP_PCT=25
# DOMAIN_USD_TO_GBP_RATE=0.79
# DOMAIN_ALLOW_PREMIUM=true

# Default WHOIS / registrant (also accepts NAMECOM_CONTACT_* / OPENSRS_CONTACT_* aliases)
# DOMAIN_CONTACT_FIRST=Domain
# DOMAIN_CONTACT_LAST=Admin
# DOMAIN_CONTACT_ORG=Aarvanta Limited
# DOMAIN_CONTACT_EMAIL=domains@yourdomain.com
# DOMAIN_CONTACT_PHONE=+44.2000000000
# DOMAIN_CONTACT_ADDRESS1=1 Example Street
# DOMAIN_CONTACT_CITY=London
# DOMAIN_CONTACT_STATE=England
# DOMAIN_CONTACT_POSTAL=EC1A 1BB
# DOMAIN_CONTACT_COUNTRY=GB

# OpenSRS fallback (only used when name.com credentials are absent)
# docs/OPENSRS_SETUP.md
# OPENSRS_USERNAME=
# OPENSRS_API_KEY=
# OPENSRS_ENV=test
# OPENSRS_FORCE_LIVE=true

# --- Build OS media (optional) ---
# Free Unsplash API key improves category imagery; without it we use curated Unsplash CDN + picsum.
# https://unsplash.com/oauth/applications
# UNSPLASH_ACCESS_KEY=

